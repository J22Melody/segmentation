# Rendered reports (reports/*.html) are tracked; everything else generated is not.

# benchmark predictions: a few MB each and regenerated in under a minute by
# benchmark/predict_*.py. The committed record is the table in benchmark/README.md.
benchmark/predictions/*.json

# derived data / scratch outputs
stats.json
*.csv
*.pkl
*.pose

# generated notebooks — the source of truth is the percent-format .py
*.ipynb

# notebook and python cruft
.ipynb_checkpoints/
__pycache__/

# training artefacts — checkpoints, logs and run state are regenerable
experiments/**/checkpoints/
experiments/**/logs/
*.ckpt
wandb/
lightning_logs/
